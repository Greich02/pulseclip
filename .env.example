# ---- Database (MongoDB Atlas) ----------------------------------------------
# Same connection string for local dev and production — a free Atlas
# cluster, no local database to run. Standing in for the Postgres the
# spec originally called for — simplification, see prisma/schema.prisma.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pulseclip?retryWrites=true&w=majority"

# ---- Cloudflare R2 (S3-compatible storage) --------------------------------
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET_NAME="pulseclip-videos"
# Public dev URL / custom domain used to read back uploaded objects.
R2_PUBLIC_HOSTNAME="pub-xxxxxxxx.r2.dev"

# ---- Deepgram (Speech-to-Text) ---------------------------------------------
# Standing in for ElevenLabs STT (originally specified) until those keys are
# available — see lib/deepgram.ts for the swap-back notes.
DEEPGRAM_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Anthropic (Claude — sequence detection & recommendations) ------------
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# ---- Inngest (async pipeline) ----------------------------------------------
INNGEST_EVENT_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
INNGEST_SIGNING_KEY="signkey-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- Resend (transactional email) ------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="PulseClip <notifications@pulseclip.io>"
# App has no login (single-user, see lib/constants.ts) — this is the one
# inbox that gets "analysis complete" / "analysis failed" emails.
NOTIFICATION_EMAIL="you@example.com"

# ---- Misc -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
